<section class="collection-list-section">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="section-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="collection-grid">
      {% for collection in section.settings.collection_list %}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__image">
            {% if collection.featured_image != blank %}
              <img 
                src="{{ collection.featured_image | image_url: width: 600 }}" 
                alt="{{ collection.title | escape }}"
                width="{{ collection.featured_image.width }}"
                height="{{ collection.featured_image.height }}"
                loading="lazy">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <h3 class="collection-card__title">{{ collection.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
<style>
.collection-list-section {
  padding: 60px 0;
  text-align: center;
}

.section-title {
  font-size: 24px;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 40px;
  font-weight: bold;
}

.collection-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr); /* 4 columns for desktop */
  gap: 20px;
  padding: 0 5%;
}

.collection-card {
  text-decoration: none;
  color: #333;
  transition: transform 0.3s ease;
}

.collection-card:hover {
  transform: translateY(-5px);
}

.collection-card__image {
  position: relative;
  aspect-ratio: 1 / 1.2; /* Slightly vertical like your image */
  overflow: hidden;
  border-radius: 15px; /* Adjust for rounded corners */
  margin-bottom: 15px;
  background-color: #f4f4f4;
}

.collection-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-card__title {
  font-size: 18px;
  color: #666;
  font-weight: 400;
  margin-top: 10px;
}

/* Mobile Responsive */
@media screen and (max-width: 990px) {
  .collection-grid {
    grid-template-columns: repeat(2, 1fr); /* 2 columns on tablets */
  }
}

@media screen and (max-width: 480px) {
  .collection-grid {
    grid-template-columns: 1fr; /* 1 column on mobile */
  }
}
</style>
{% schema %}
{
  "name": "Collection List Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "GET STARTED"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "limit": 8
    }
  ],
  "presets": [
    {
      "name": "Collection List Grid"
    }
  ]
}
{% endschema %}