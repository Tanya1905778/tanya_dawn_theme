<section class="know-story-section">
 <div id="know-our-story-{{ section.id }}" class="page-width">
    <div class="know-story-grid">
      <!-- LEFT IMAGE -->
      <div class="know-story-media">
        {% if section.settings.video != blank %}
             <div class="video-wrapper">
         {{
  section.settings.video
  | video_tag:
    autoplay: false,
    loop: false,
    muted: true,         
    controls: false,
    playsinline: true,
    class: 'know-story-video',
    data-section-id: section.id
}}
            <button
        class="video-toggle-btn"
        id="video-toggle-{{ section.id }}"
        data-video="know-our-story-video"
      >
    Play
      </button>
      </div>
        {% endif %}
       
      </div>

      <!-- RIGHT CONTENT -->
      <div class="know-story-content">
        <h2>{{ section.settings.heading }}</h2>

        <div class="know-story-text">
          {{ section.settings.description }}
        </div>

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="story-btn"> {{ section.settings.button_text }} → </a>
        {% endif %}

        <!-- FEATURES -->
       <div id="quality-cards-list-{{ section.id }}" class="quality-cards-list swiper mySwiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'quality_card' %}
             
              <div class="quality-card swiper-slide">
               
                {% if block.settings.quality_card_image != blank %}
                  <div class="quality-card__icon-wrapper">
                    {{
                      block.settings.quality_card_image
                      | image_url: width: 200
                      | image_tag: class: 'quality-card__icon', alt: block.settings.quality_card_heading
                    }}
                  </div>
                {% endif %}

                <h2 class="quality-card__heading">
                  {{ block.settings.quality_card_heading }}
                </h2>

                <p class="quality-card__text">
                  {{ block.settings.quality_card_text_content }}
                </p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div id="swiper-button-prev-{{ section.id }}" class="swiper-button-prev"></div>
<div id="swiper-button-next-{{ section.id }}" class="swiper-button-next"></div>
      </div>
      </div>
    </div>

    <!-- BOTTOM ICONS -->
    <div class="story-icons">
      {% for block in section.blocks %}
        {% if block.type == 'icon' %}
          <div class="icon-item">
            <span class="icon">{{ block.settings.icon }}</span>
            <p>{{ block.settings.label }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Know Our Story",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted video"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know Our Story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "READ MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "quality_card",
      "name": "Quality card",
      "settings": [
            {
          "type": "image_picker",
          "id": "quality_card_image",
          "label": "Select image"
        },
        {
          "type": "text",
          "id": "quality_card_heading",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "quality_card_text_content",
          "label": "Text"
        }
      ]
    },
    {
      "type": "icon",
      "name": "Bottom icon",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or symbol)",
          "default": "📦"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Know Our Story"
    }
  ]
}
{% endschema %}






<script>
  function initQualitySwiper(sectionId) {
    const swiperEl = document.querySelector(
      `#quality-cards-list-${sectionId}`
    );

    if (!swiperEl || swiperEl.classList.contains('swiper-initialized')) return;

    new Swiper(swiperEl, {
      slidesPerView: 1.5,
      spaceBetween: 16,
      navigation: {
        nextEl: `#swiper-button-next-${sectionId}`,
        prevEl: `#swiper-button-prev-${sectionId}`,
      },
      mousewheel: true,
      keyboard: true,
    });
  }

 
  document.addEventListener('DOMContentLoaded', () => {
    initQualitySwiper('{{ section.id }}');
  });


  document.addEventListener('shopify:section:load', (e) => {
    initQualitySwiper(e.detail.sectionId);
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', VideoController);
  document.addEventListener('shopify:section:load', VideoController);

let videoControllerInitialized = false;
  function VideoController() {
if (videoControllerInitialized) return;
  videoControllerInitialized = true;

    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.video-toggle-btn');
      if (!btn) return;

      e.stopPropagation();

      const wrapper = btn.closest('.video-wrapper');
      const video = wrapper?.querySelector('video');
      if (!video) return;

      const allVideos = document.querySelectorAll('video');
      const allButtons = document.querySelectorAll('.video-toggle-btn');

      allVideos.forEach(v => {
        if (v !== video && !v.paused)
         v.pause();
      });

      allButtons.forEach(b => b.textContent = 'Play');

      try {
        if (video.paused) {
          video.muted = true;
          await video.play();
          video.muted = false;
          btn.textContent = 'Pause';
        } else {
          video.pause();
          btn.textContent = 'Play';
        }
      } catch (err) {
        console.error('Video play error', err);
      }
    });
  }
</script>





<style>
