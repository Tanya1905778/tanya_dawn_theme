<section
  class="skincare-section"
  style="
        background-image:
    {% if section.settings.image != blank %}
      url('{{ section.settings.image | image_url: width: 2000 }}')
    {% else %}
      url('{{ 'girl-skincare.svg' | asset_url }}')
    {% endif %}
  "
>
  <div class="skincare-overlay">
    <div class="skincare-content">
      <div class="skincare-left">
        <h2>{{ section.settings.heading }}</h2>
      </div>

      <div class="skincare-right">
        <div class="gender-tabs">
          <button class="tab active" data-target="men">
            {{ section.settings.men_label }}
          </button>
          <button class="tab" data-target="women">
            {{ section.settings.women_label }}
          </button>
        </div>

        {% comment %} <div id="men-swiper-container" class="skincare-swiper active">
          <div class="swiper mySwiper men-swiper">
            <div class="swiper-wrapper men-swaper-wrapper">
              {% for product in section.settings.men_collection.products %}
                <div class="swiper-slide">
                  <div class="product-card">
                    {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                    <h4>{{ product.title }}</h4>
                    <p>{{ product.price | money }}</p>
                    <a href="{{ product.url }}" class="btn">ADD TO BAG</a>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
          </div>
        </div> {% endcomment %}

        <div id="women-swiper-container" class="skincare-swiper">
          <div class="swiper mySwiper">
            <div class="swiper-wrapper">
              {% for product in section.settings.women_collection.products limit: 6 %}
                <div class="swiper-slide">
                  <div class="product-card">
                    {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                    <h4>{{ product.title }}</h4>
                    <p>{{ product.price | money }}</p>
                    <a href="{{ product.url }}" class="btn">ADD TO BAG</a>
                  </div>
                </div>
              {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Initialize Swiper with CodeSandbox settings
    const swiperOptions = {
      slidesPerView: 4, // Allows the width to be defined by CSS
      spaceBetween: 30,

      centeredSlides: true,
      //   observer: true,         // Vital for tabs
      //   observeParents: true,   // Vital for tabs
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
    };

    // Initialize both sliders
    const swipers = new Swiper('.mySwiper', swiperOptions);

    // Tab Switching Logic
    const tabs = document.querySelectorAll('.gender-tabs .tab');
    const containers = document.querySelectorAll('.skincare-swiper');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');

        // Update Tab buttons
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        // Update Content visibility
        containers.forEach((container) => {
          container.classList.remove('active');
          if (container.id === target + '-swiper-container') {
            container.classList.add('active');
          }
        });
      });
    });
  });
</script>
