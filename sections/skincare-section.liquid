{% schema %}
{
  "name": "Skincare Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Skincare Essentials"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image Heading"
    },
    {
      "type": "text",
      "id": "men_label",
      "label": "Men button label",
      "default": "MEN"
    },
    {
      "type": "text",
      "id": "women_label",
      "label": "Women button label",
      "default": "WOMEN"
    },
    {
      "type": "collection",
      "id": "men_collection",
      "label": "Men collection"
    },
    {
      "type": "collection",
      "id": "women_collection",
      "label": "Women collection"
    }
  ],
  "presets": [
    {
      "name": "Skincare Section"
    }
  ]
}
{% endschema %}
